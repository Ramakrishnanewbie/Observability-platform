FROM golang:latest AS builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN GONOSUMDB=* GOTOOLCHAIN=local go mod download
COPY cmd/server/ ./cmd/server/
RUN GONOSUMDB=* GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /observo-server ./cmd/server/

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /observo-server /usr/local/bin/observo-server
EXPOSE 8080
ENTRYPOINT ["observo-server"]
