FROM golang:1.24-alpine AS builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN GONOSUMDB=* GOTOOLCHAIN=local go mod download
COPY cmd/agent/ ./cmd/agent/
RUN GONOSUMDB=* GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /observo-agent ./cmd/agent/

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /observo-agent /usr/local/bin/observo-agent
ENTRYPOINT ["observo-agent"]
